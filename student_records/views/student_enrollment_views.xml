<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="student_enrollment_view_form" model="ir.ui.view">
        <field name="name">student.enrollment.form</field>
        <field name="model">student.enrollment</field>
        <field name="arch" type="xml">
            <form string = "Enrollment Details">
                <sheet>
                    <group>
                        <field name="subject_id"/>
                        <field name="grade"/>
                        <field name="status"/>
                        <field name="student_course"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>