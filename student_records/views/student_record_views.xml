<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Student Record Views -->
    <record id ="student_record_view_tree" model="ir.ui.view">
        <field name="name">student.record.tree</field>
        <field name="model">student.record</field>
        <field name="arch" type="xml">
            <tree string="Student Records">
                <field name="reference"/>
                <field name="name"/>
                <field name="course"/>
                <field name="student_yearlvl"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id = "student_record_view_form" model="ir.ui.view">
        <field name="name">student.record.form</field>
        <field name="model">student.record</field>
        <field name="arch" type="xml">
            <form string="Student Record">
                <header>
                    <button
                        name="action_graduated"
                        string="Mark as Graduated"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('status', '=', 'graduated')]}"/>
                    <button
                        name="action_dropped"
                        string="Mark as Dropped"
                            type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('status', '=', 'dropped')]}"/>
                    <button
                        name="action_enrolled"
                        string="Mark as Enrolled"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('status', '=', 'enrolled')]}"/>
                    <button
                        name="action_archive"
                        string="Archive"
                        type="object"
                        class="btn-secondary"
                        confirm="This student will be hidden from the student list. Are you sure you want to archive this record?"
                        attrs="{'invisible': [('active', '=', False)]}"/>
                    <button
                        name="action_unarchive"
                        string="Unarchive"
                        type="object"
                        class="btn-secondary"
                        confirm="This student will be shown on the student list. Are you sure you want to unarchive this record?"
                        attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="status"
                        widget="statusbar"
                        statusbar_visible="enrolled,graduated,dropped"/>
                </header>
                <sheet>
                    <group>
                        <field name="reference"/>
                        <field name="name"/>
                        <field name = "course"/>
                        <field name = "student_yearlvl"/>
                        <field name = "email"/>
                        <field name = "gpa"/>
                        <field name = "enrollment_date"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook> 
                        <page string="First Year">
                            <field name="first_year_ids" context="{'default_enrollment_yearlvl' :  'first_year'}">
                                <tree>
                                    <field name="subject_id"/>
                                    <field name="grade"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Second Year" attrs = "{'invisible': [('student_yearlvl', 'not in', ['second_year', 'third_year','fourth_year'])]}">
                            <field name="second_year_ids" context="{'default_enrollment_yearlvl' : 'second_year'}">
                                <tree>
                                    <field name="subject_id"/>
                                    <field name="grade"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Third Year" attrs = "{'invisible' : [('student_yearlvl', 'not in', ['third_year','fourth_year'])]}">
                            <field name="third_year_ids" context="{'default_enrollment_yearlvl' : 'third_year'}">
                                <tree>
                                    <field name="subject_id"/>
                                    <field name="grade"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Fourth Year" attrs = "{'invisible' : [('student_yearlvl', 'not in', ['fourth_year'])]}">
                            <field name="fourth_year_ids" context="{'default_enrollment_yearlvl' : 'fourth_year'}">
                                <tree>
                                    <field name="subject_id"/>
                                    <field name="grade"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="student_record_action" model="ir.actions.act_window">
        <field name="name">Student Records</field>
        <field name="res_model">student.record</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="student_record_menu"
        name="Student Records"
        sequence = "10"/>
    
    <menuitem id="student_record_menu_records"
        name="Records"
        parent="student_record_menu"
        action="student_record_action"
        sequence="1"/>

    <!-- Search -->
    <record id="student_record_view_search" model="ir.ui.view">
        <field name="name">student.record.search</field>
        <field name="model">student.record</field>
        <field name="arch" type="xml">
            <search string="Search Student">
                <field name="name"/>
                <field name="course"/>
                <field name="student_yearlvl"/>
                <filter string="Enrolled" name="enrolled" domain="[('status', '=', 'enrolled')]"/>
                <filter string="Graduated" name="graduated" domain="[('status', '=', 'graduated')]"/>
                <filter string="Dropped" name="dropped" domain="[('status', '=', 'dropped')]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Course" name="group_by_course" context="{'group_by':'course'}"/>
                    <filter string="Year Level" name="group_by_yearlvl" context="{'group_by':'student_yearlvl'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>