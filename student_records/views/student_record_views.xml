<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Student Record Views -->
    <record id ="student_record_view_tree" model="ir.ui.view">
        <field name="name">student.record.tree</field>
        <field name="model">student.record</field>
        <field name="arch" type="xml">
            <tree string="Student Records">
                <field name="student_id"/>
                <field name="name"/>
                <field name = "course"/>
                <field name = "yearlvl"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id = "student_record_view_form" model="ir.ui.view">
        <field name="name">student.record.form</field>
        <field name="model">student.record</field>
        <field name="arch" type="xml">
            <form string="Student Record">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="name"/>
                        <field name = "course"/>
                        <field name = "yearlvl"/>
                    </group>
                    <notebook>
                        <page string="Subjects">
                            <field name="subject_ids">
                                <tree>
                                    <field name="subjectName"/>
                                    <field name="grade"/>
                                    <field name="units"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
</odoo>