<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_student_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">


                        <!-- Student Info-->
                        <h2>Student Report</h2>
                        <table class = "table table-bordered">
                            <tr>
                                <td><strong>Student ID</strong></td>
                                <td><t t-esc="doc.reference"/></td>
                                <td><strong>Name</strong></td>
                                <td><t t-esc="doc.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Course</strong></td>
                                <td><t t-esc="dict(doc._fields['course'].selection).get(doc.course)"/></td>
                                <td><strong>Year Level</strong></td>
                                <td><t t-esc="dict(doc._fields['student_yearlvl'].selection).get(doc.student_yearlvl)"/></td>
                            </tr>
                            <tr>
                                <td><strong>GPA</strong></td>
                                <td><t t-esc="doc.gpa"/></td>
                                <td><strong>Status</strong></td>
                                <td><t t-esc="dict(doc._fields['status'].selection).get(doc.status)"/></td>
                            </tr>
                        </table>

                        <!-- Semesters and Subjects -->
                        <t t-foreach="doc.semester_ids" t-as="semester">
                            <h4>
                                <t t-esc="dict(semester._fields['semester_enrollment_yearlvl'].selection).get(semester.semester_enrollment_yearlvl)"/>
                                -
                                <t t-esc="dict(semester._fields['semester'].selection).get(semester.semester)"/>
                            </h4>
                            <table class="table table-bordered">
                                <thread>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Grade</th>
                                        <th>Status</th>
                                    </tr>
                                </thread>
                               <tbody>
                                    <t t-foreach="semester.semester_enrollment_ids" t-as="enrollment">
                                        <tr>
                                            <td><t t-esc="enrollment.subject_id.name"/></td>
                                            <td><t t-esc="enrollment.grade"/></td>
                                            <td><t t-esc="enrollment.status"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <p>
                                <strong>Semestral GPA: </strong>
                                <t t-esc="semester.semestral_gpa"/>
                            </p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template> 
</odoo>
