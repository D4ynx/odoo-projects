<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="library_book_view_tree" model="ir.ui.view">
        <field name="name">library.book.tree</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <tree string="Books">
                <field name="name"/>
                <field name="author_id"/>
                <field name="date_published"/>
                <field name="is_featured"/>
            </tree>
        </field>
    </record>

    <!--Form View-->
    <record id="library_book_view_Form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button 
                        name="action_feature"
                        string="Mark as Featured"
                        type="object"
                        class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="reference"/>
                        <field name="name"/>
                        <field name="author_id"/>
                        <field name="isbn"/>
                        <field name="date_published"/>
                        <field name="active"/>
                        <field name="is_featured"/>
                        <field name="days_since_published"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="library_menu_root" 
            name="Library"
            sequence="10"/>

    <menuitem id="library_menu_books"
            name="Books"
            parent="library_menu_root"
            action="library_book_action"
            sequence="1"/>
        
    <!-- Search -->
    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="name"/>
                <field name="author_id"/>
                <filter string="Featured" name="featured" domain="[('is_featured', '=', True)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Author" name="group_by_author" context="{'group_by':'author_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
