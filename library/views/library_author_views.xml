<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--List View-->
    <record id="library_author_view_tree" model="ir.ui.view">
        <field name="name">library.author.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <tree string="Authors">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!--Form View-->
    <record id="library_author_view_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="bio"/>
                        <field name="nationality"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="library_author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="library_menu_authors"
            name="Authors"
            parent="library_menu_root"
            action="library_author_action"
            sequence="2"/>
</odoo>
